<view class="page">
  <text class="kicker">College basketball’s knockout tournament</text><text class="title">64 teams.
One champion.</text><text class="body">Pick who wins. One loss sends a team home. Your predictions make a bracket.</text><image src="/assets/your-turn.png" mode="aspectFit" class="intro-hand"/>
  <view class="tournament-path"><view><text class="path-number">64</text><text class="path-label">Teams</text></view><text>→</text><view><text class="path-number">16</text><text class="path-label">Sweet 16</text></view><text>→</text><view><text class="path-number">4</text><text class="path-label">Final Four</text></view><text>→</text><view><text class="path-number">1</text><text class="path-label">Champion</text></view></view>
  <view class="card camp-card"><text class="kicker">Your warm-up</text><text class="section-title">Fan camp</text><view class="row between"><view><text class="kicker">Practice XP</text><text class="bold">{{progress.level}}</text></view><text class="xp">{{progress.xp}}<text class="small muted-inline"> / 120 XP</text></text></view><progress percent="{{progress.xp / 120 * 100}}" activeColor="#1AA5C0" backgroundColor="#E9ECF0" stroke-width="8" border-radius="8"/><text class="muted small">{{progress.completed}} / 10 challenges complete</text>
  <view class="badges"><view class="badge {{item.earned ? 'earned' : ''}}" wx:for="{{progress.badges}}" wx:key="name"><text class="badge-icon">{{item.earned ? '✓' : item.icon}}</text><text>{{item.name}}</text><text class="badge-hint">{{item.earned ? 'Earned' : item.hint}}</text></view></view>
  <text class="reward" wx:if="{{notice}}" aria-role="status">{{notice}}</text>
  <view class="tabs"><button class="pill {{mode === 'games' ? 'active' : ''}}" data-value="games" bindtap="mode">Pick games</button><button class="pill {{mode === 'mini' ? 'active' : ''}}" data-value="mini" bindtap="mode">Mini bracket</button><button class="pill {{mode === 'quiz' ? 'active' : ''}}" data-value="quiz" bindtap="mode">Quick quiz</button></view>
  <view wx:if="{{mode === 'games'}}"><view class="steps"><button class="step {{item.active ? 'selected' : ''}}" wx:for="{{steps}}" wx:key="index" bindtap="gameStep" data-index="{{item.index}}">{{item.label}}</button></view><text class="kicker">Game {{index + 1}} / 6 · {{practice.year}}</text><text class="section-title">{{practice.title}}</text><text class="muted body">{{practice.clue}}</text><view class="game"><button class="practice-team {{item.picked ? 'picked' : ''}}" wx:for="{{practice.teams}}" wx:key="id" bindtap="pick" data-id="{{item.id}}" disabled="{{!!practice.answer}}"><image class="logo" src="{{item.logo}}" mode="aspectFit"/><view class="grow"><text class="team-name">{{item.name}}</text><text class="seed">#{{item.seed}} seed</text></view><text wx:if="{{practice.answer}}" class="score">{{item.score}}</text><text wx:if="{{item.picked}}" class="check">✓</text></button></view>
  <view wx:if="{{practice.answer}}" class="reveal"><text class="bold">{{practice.winner}} advances.</text><text class="body">{{practice.why}}</text><text class="takeaway">{{practice.lesson}}</text><button class="red" bindtap="next">{{index === 5 ? 'Try the mini bracket' : 'Next game'}} →</button></view><text wx:else class="muted">Choose your winner. Earn 10 practice XP.</text></view>
  <view wx:if="{{mode === 'mini'}}"><text class="section-title">Build a Final Four.</text><text class="muted body">Two semifinals. One champion. Finish for 30 practice XP.</text><view wx:for="{{mini}}" wx:key="slot" wx:for-item="match" class="game"><view class="game-head">{{match.label}}</view><button wx:for="{{match.teams}}" wx:key="id" class="practice-team {{item.picked ? 'picked' : ''}}" bindtap="miniPick" data-slot="{{match.slot}}" data-id="{{item.id}}"><image class="logo" src="{{item.logo}}" mode="aspectFit"/><text class="grow team-name">{{item.name}}</text><text class="check" wx:if="{{item.picked}}">✓</text></button><text class="notice" wx:if="{{!match.teams.length}}">Pick both semifinal winners first.</text></view><button class="outline" wx:if="{{miniDone}}" bindtap="replay">Try a new mini bracket</button><button class="link" data-value="quiz" bindtap="mode">Try the quick quiz →</button></view>
  <view wx:if="{{mode === 'quiz'}}"><view class="steps"><button wx:for="{{quizSteps}}" wx:key="index" class="step {{quizIndex === item.index ? 'selected' : ''}}" bindtap="quizStep" data-index="{{item.index}}">{{item.label}}</button></view><text class="section-title">{{quiz.question}}</text><button class="answer {{item.correct ? 'correct' : ''}}" wx:for="{{quiz.options}}" wx:key="index" data-index="{{item.index}}" bindtap="answer" disabled="{{quiz.done}}">{{item.correct ? '✓ ' : ''}}{{item.text}}</button><text class="notice" wx:if="{{quizFeedback}}" aria-role="status">{{quizFeedback}}</text><text class="notice" wx:if="{{quiz.done &amp;&amp; !quizFeedback}}">{{quiz.why}}</text></view>
  <view wx:if="{{progress.completed === 10}}" class="complete"><text class="section-title">March ready. ★</text><text class="body">120 practice XP. Your real bracket is waiting.</text><button class="red" bindtap="bracket">Make my picks →</button></view>
  <text class="muted small body">Practice XP is separate from bracket points. Progress saves on this device.</text></view>
  <button class="outline" bindtap="rules">{{showRules ? 'Hide rules' : 'Rules &amp; scoring'}} {{showRules ? '−' : '+'}}</button><view class="card" wx:if="{{showRules}}"><text class="rule">The tournament begins here with 64 teams. Six wins make a champion.</text><text class="rule">Correct picks earn 10, 20, 40, 80, 160 and 320 points by round. Maximum: 1,920.</text><text class="rule">Changing an early pick clears later picks that depended on it.</text><text class="rule">This uses the 2026 field. Entries stay on this device. Demo results are simulated.</text></view><button class="link" bindtap="bracket">Skip to my bracket →</button>
</view><include src="../../templates/footer.wxml"/>
