.title{white-space:pre-line}.tournament-path{display:flex;align-items:center;justify-content:space-between;margin:32rpx 0}.tournament-path view{text-align:center}.tournament-path view text{display:block;font-weight:900;font-size:46rpx}.tournament-path view text+text{font-size:18rpx;color:#686F7A;font-weight:500}.camp-card{border-top:8rpx solid #D62B38}.xp{font-size:42rpx;font-weight:900}.muted-inline{color:#757B85;font-weight:400}progress{margin:22rpx 0 12rpx}.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:28rpx 0}.badge{text-align:center;border:2rpx dashed #CDD0D8;border-radius:16rpx;padding:18rpx 5rpx;color:#7A808B;font-size:18rpx}.badge text{display:block}.badge .badge-icon{font-size:34rpx;font-weight:900}.badge-hint{font-size:16rpx;margin-top:4rpx}.badge.earned{border:2rpx solid #1AA5C0;color:#126478;background:#E6F8FB}.steps{display:flex;gap:12rpx;margin:22rpx 0 28rpx}.step{width:64rpx;height:64rpx;padding:0;border:2rpx solid #D8DCE3;border-radius:50%;line-height:60rpx;font-size:24rpx}.step.selected{background:#17191F;color:white;border-color:#17191F}.reward{display:block;background:#D9F5FA;color:#126478;font-weight:850;border-radius:12rpx;padding:18rpx}.practice-team{display:flex;align-items:center;gap:18rpx;width:100%;min-height:130rpx;border-radius:0;text-align:left;background:#fff}.practice-team+.practice-team{border-top:1rpx solid #E2E5EB}.practice-team.picked{background:#DFF6FB;box-shadow:inset 6rpx 0 #1AA5C0}.practice-team[disabled]{opacity:1;color:#17191F}.reveal{background:#F5F6F9;padding:24rpx;border-radius:16rpx}.takeaway{display:block;border-left:6rpx solid #D62B38;padding-left:20rpx;margin:24rpx 0}.answer{text-align:left;margin:16rpx 0;border:2rpx solid #DFE3EA;font-weight:500}.answer.correct{border-color:#139FB9;background:#DFF6FB}.answer[disabled]{opacity:1}.complete{border-top:1rpx solid #D3E5E8;padding-top:28rpx;margin-top:30rpx}
.intro-hand{display:block;width:100%;height:260rpx;margin:20rpx 0}
.tournament-path .path-number{display:block;font-size:46rpx;font-weight:900}.tournament-path .path-label{display:block;font-size:20rpx;color:#686F7A;font-weight:500;white-space:nowrap}
