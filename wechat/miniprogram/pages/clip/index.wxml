<view class="page"><view class="row between"><text class="kicker">{{moment.year}} · {{moment.tag}}</text><text class="muted small">{{index + 1}} / {{total}}</text></view><text class="title">{{moment.headline}}</text><view class="clip-stage"><video wx:if="{{playing}}" id="momentVideo" src="{{videoUrl}}" poster="{{moment.poster}}" controls="{{true}}" autoplay="{{true}}" show-center-play-btn="{{true}}" object-fit="contain" binderror="error" title="{{moment.title}}"/><image wx:else src="{{moment.poster}}" mode="aspectFit"/></view><text class="body bold">{{moment.title}}</text><text class="muted body">{{moment.caption}}</text><button class="red" wx:if="{{videoUrl &amp;&amp; !playing &amp;&amp; !failed}}" bindtap="play">▶ Play clip</button><view class="notice" wx:if="{{!videoUrl || failed}}"><text>{{failed ? 'This clip could not play.' : 'Video playback is not connected in this development version.'}}</text><text class="body">Try the game behind the moment, or copy the official clip link.</text></view><view class="row clip-navigation"><button class="outline grow" bindtap="previous" disabled="{{index === 0}}">← Previous</button><button class="outline grow" bindtap="next" disabled="{{index === total - 1}}">Next →</button></view><button class="red" bindtap="practice">{{moment.practice !== undefined ? 'Try this game' : 'Start Fan camp'}} →</button><button class="link" bindtap="archive">Explore the {{moment.archive || 2026}} bracket →</button><button class="link" bindtap="source">Copy official NCAA clip link ↗</button><text class="muted small">Preview: NCAA / March Madness. Playback requires a hosted, licensed video source. No video loads before you tap Play.</text></view><include src="../../templates/footer.wxml"/>
