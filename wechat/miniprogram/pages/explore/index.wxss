.region-canvas{display:block;max-width:100%;margin:0 auto 20rpx}.map-card{padding-bottom:16rpx}.roster{border-top:8rpx solid}.group-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.group-tile{color:#fff;text-align:left;padding:24rpx}.group-tile text{display:block;font-size:22rpx;margin:8rpx 0}.group-tile .bold{font-size:32rpx}.player-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.player-card{padding:0;text-align:left;overflow:hidden;background:white;border:1rpx solid #DEE1E7}.player-art{height:360rpx}.player-art image{width:100%;height:100%}.player-copy{padding:24rpx 20rpx}.player-name{font-size:30rpx;font-weight:850;display:block;line-height:1.15;margin-bottom:10rpx}.player-copy .muted{font-weight:400;margin-top:6rpx}
