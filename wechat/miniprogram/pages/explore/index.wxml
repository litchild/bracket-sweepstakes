<view class="page"><text class="kicker">Find your team</text><text class="title">Teams &amp; regions.</text><view class="tabs"><button class="pill {{section === 'regions' ? 'active' : ''}}" bindtap="section" data-value="regions">Regions</button><button class="pill {{section === 'players' ? 'active' : ''}}" bindtap="section" data-value="players">Players</button><button class="pill" bindtap="archive">Past brackets ↗</button></view>
  <view wx:if="{{section === 'regions'}}"><view class="tabs"><button class="pill {{meaning === 'home' ? 'active' : ''}}" bindtap="meaning" data-value="home">School home regions</button><button class="pill {{meaning === 'tournament' ? 'active' : ''}}" bindtap="meaning" data-value="tournament">Tournament groups</button></view><text class="muted body">{{meaning === 'home' ? 'Where schools are based. Tap a region.' : 'Four groups. Each sends one team to the Final Four.'}}</text><button class="link" bindtap="explain">Why two kinds of region? {{showExplain ? '−' : '+'}}</button><text class="notice" wx:if="{{showExplain}}">Home regions show geography. Tournament groups set the matchups. Purdue is a Midwest school playing in the West tournament group.</text>
    <view class="card map-card"><view wx:if="{{meaning === 'home'}}"><canvas canvas-id="regionMap" id="regionMap" class="region-canvas" style="width:{{mapWidth}}px;height:{{mapHeight}}px" bindtouchstart="mapTouch" disable-scroll="{{true}}" aria-label="Tap a school home region on the map"/><text class="muted small">Simplified map · Hawaii inset · 北 = Midwest</text></view><view wx:else class="group-grid"><button wx:for="{{roots}}" wx:key="id" class="group-tile" style="background:{{item.color}}" bindtap="region" data-id="{{item.id}}"><text class="bold">{{item.name}}</text><text>16 teams ↓</text><text>1 Final Four place</text></button></view>
    <view class="tabs"><button wx:for="{{roots}}" wx:key="id" class="pill" style="border-color:{{item.color}};background:{{region === item.id ? item.color : '#FFFFFF'}};color:{{region === item.id ? '#FFFFFF' : item.color}}" bindtap="region" data-id="{{item.id}}">{{item.zh}} {{item.name}}</button></view><view wx:if="{{meaning === 'home'}}"><view class="divider"></view><text class="body">{{selected.see}}</text><button class="link" bindtap="ambassadors">Regional ambassadors {{showAmbassadors ? '−' : '+'}}</button><text class="muted body" wx:if="{{showAmbassadors}}">{{selected.guides}}</text><button class="dark" bindtap="root" disabled="{{locked}}">Pick for the {{selected.name}} →</button><text class="muted small body">Auto-fills 63 picks. Edit any game.</text></view></view>
    <view class="card roster" style="border-top-color:{{selected.color}}"><text class="kicker">{{schools.length}} schools · {{meaning === 'home' ? 'Home region' : 'Tournament group'}}</text><text class="section-title">{{selected.zh}} {{selected.name}}</text><button wx:for="{{schools}}" wx:key="id" class="school-row" bindtap="profile" data-id="{{item.id}}"><image class="logo" src="{{item.logo}}" mode="aspectFit"/><view class="grow"><text class="team-name">{{item.name}}</text><text class="muted">{{item.context}} · #{{item.seed}} seed</text></view><text wx:if="{{item.cn}}" class="cn">中</text><text>→</text></button></view>
  </view>
  <view wx:if="{{section === 'players'}}"><text class="muted body">Four players. A new reason to follow March.</text><view class="player-grid"><button wx:for="{{players}}" wx:key="id" class="player-card" bindtap="player" data-id="{{item.id}}"><view class="player-art" style="background:{{item.color}}"><image src="{{item.photo}}" mode="aspectFill"/></view><view class="player-copy"><text class="player-name">{{item.name}}</text><text class="muted">{{item.school}}</text><text class="muted small">{{item.position}} · {{item.year}}</text></view></button></view><text class="notice">2026–27 rosters · School marks and official portraits are credited in each profile.</text></view>
</view><include src="../../templates/footer.wxml"/>
