.home-header{background:#111316;color:white;padding:28rpx}.home-wordmark{font-weight:900;font-style:italic;font-size:30rpx;letter-spacing:-1rpx}.home-header .concept{font-size:15rpx}.home-prize{display:block;font-size:40rpx;font-weight:900;font-style:italic;background:#D62B38;transform:skew(-5deg);padding:6rpx 20rpx;margin:22rpx 0 12rpx;width:fit-content}.hero{height:760rpx;position:relative;border-radius:22rpx;overflow:hidden;padding:0;text-align:left;background:#101114;color:#fff}.hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-shade{background:linear-gradient(180deg,transparent 10%,rgba(0,0,0,.92) 100%)}.hero-copy{position:absolute;bottom:32rpx;left:30rpx;right:30rpx}.hero-tag{font-size:18rpx;background:#D62B38;display:inline-block;padding:10rpx 16rpx;border-radius:7rpx;letter-spacing:1rpx}.hero-title{display:block;font-size:62rpx;letter-spacing:-3rpx;font-weight:900;font-style:italic;line-height:1.02;margin:20rpx 0;white-space:pre-line}.hero-score{display:block;font-weight:500;font-size:26rpx}.hero-link{display:inline-block;margin-top:24rpx;padding:18rpx 24rpx;background:#D62B38;border-radius:10rpx;font-size:25rpx}.home-section{margin:50rpx 0}.clip-scroll{white-space:nowrap}.clip-card{display:inline-block;width:480rpx;margin-right:22rpx;vertical-align:top;white-space:normal}.clip-image-button{position:relative;padding:0;height:280rpx;overflow:hidden;border-radius:18rpx;background:#141619}.clip-image{width:100%;height:100%}.clip-tag{position:absolute;bottom:12rpx;left:12rpx;color:#fff;background:#15171D;padding:6rpx 12rpx;font-size:20rpx;border-radius:8rpx}.clip-title{font-size:30rpx;font-weight:850;display:block;line-height:1.15;margin:18rpx 0 12rpx}.your-turn{margin-top:28rpx;border-top:8rpx solid #D62B38}.hand{width:100%;height:300rpx}.home-tile{text-align:left;padding:32rpx}.home-tile text{display:block}.home-tile .muted{font-weight:400;margin-top:10rpx}
