.profile-heading{margin:16rpx 0 40rpx}.school-logo{width:140rpx;height:140rpx;margin-bottom:24rpx}.profile-heading .title{font-size:58rpx}.stat{padding:20rpx 0}.stat-value{display:block;font-size:54rpx;font-weight:900}.player-link{display:flex;gap:22rpx;align-items:center;text-align:left;padding:18rpx}.player-link image{width:100rpx;height:120rpx;border-radius:12rpx}.player-hero{position:relative;height:650rpx;border-radius:22rpx;overflow:hidden;color:white}.player-hero>image{width:100%;height:100%}.player-title{position:absolute;left:0;bottom:0;width:100%;padding:70rpx 28rpx 30rpx;background:linear-gradient(transparent,rgba(0,0,0,.92))}.player-title .title{font-size:64rpx;margin:14rpx 0}.player-title .kicker{color:#E6E8ED}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin:30rpx 0}.facts view{padding:18rpx 0;border-bottom:1rpx solid #C8CDD5}.facts .label{margin-bottom:10rpx}
