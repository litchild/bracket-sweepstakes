<view class="page"><view class="tabs" wx:if="{{player}}"><button class="pill {{type === 'school' ? 'active' : ''}}" bindtap="type" data-value="school">School</button><button class="pill {{type === 'player' ? 'active' : ''}}" bindtap="type" data-value="player">Player</button></view>
  <view wx:if="{{type === 'school'}}"><view class="profile-heading"><image class="school-logo" src="{{team.logo}}" mode="aspectFit"/><text class="kicker">#{{team.seed}} seed · {{group}} group</text><text class="title">{{school.fullName}}</text><text class="muted">{{home}} school</text></view><view class="card"><text class="section-title">Recent seasons.</text><view class="grid2"><view class="stat"><text class="kicker">2025–26</text><text class="stat-value">{{school.recent}}</text><text class="muted small">Wins–losses</text></view><view class="stat"><text class="kicker">2024–25</text><text class="stat-value">{{school.previous}}</text><text class="muted small">Wins–losses</text></view></view><text class="muted small body">Archived ESPN records</text></view><button class="player-link" wx:if="{{player}}" bindtap="type" data-value="player"><image src="{{player.photo}}" mode="aspectFill"/><view class="grow"><text class="kicker">Player to follow</text><text class="team-name">{{player.name}}</text></view><text>→</text></button></view>
  <view wx:if="{{type === 'player' &amp;&amp; player}}"><view class="player-hero" style="background:{{player.color}}"><image src="{{player.photo}}" mode="aspectFill"/><view class="player-title"><text class="kicker">{{team.name}} · #{{player.number}}</text><text class="title">{{player.name}}</text><text>{{player.hometown}}</text></view></view><view class="facts"><view><text class="label">Position</text><text>{{player.position}}</text></view><view><text class="label">Height</text><text>{{player.height}}</text></view><view><text class="label">Year</text><text>{{player.year}}</text></view></view><text class="body">{{player.story}}</text><view class="card"><text class="kicker">{{player.statLabel}}</text><view class="grid2"><view wx:for="{{player.stats}}" wx:key="index" class="stat"><text class="stat-value">{{item[0]}}</text><text class="muted small">{{item[1]}}</text></view></view></view><button class="red" bindtap="champion" disabled="{{locked}}">Pick {{team.name}} as champion →</button><text class="muted small body">Auto-fills all 63 picks. Edit any game.</text><text class="photo-credit">2026–27 roster · Photo: {{player.credit}}</text></view>
  <button class="link" bindtap="source">Copy {{type === 'player' ? 'official player bio' : 'team &amp; roster'}} link ↗</button><button class="outline" open-type="share">Share this profile ↗</button>
</view><include src="../../templates/footer.wxml"/>
