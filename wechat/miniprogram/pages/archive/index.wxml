<view class="page"><text class="kicker">March, remembered.</text><view class="row between"><text class="title">The road to one.</text><picker mode="selector" range="{{years}}" value="{{yearIndex}}" bindchange="year"><view class="year-picker">{{year}} ▾</view></picker></view><view class="card champion"><image src="{{champion.logo}}" class="champ-logo" mode="aspectFit"/><text class="kicker">{{year}} national champions</text><text class="section-title">{{champion.name}}</text><text class="muted">Six wins. One title.</text></view><view class="tabs"><button class="pill {{mode === 'path' ? 'active' : ''}}" data-value="path" bindtap="mode">Champion’s path</button><button class="pill {{mode === 'full' ? 'active' : ''}}" data-value="full" bindtap="mode">Full bracket · 63 games</button></view><view wx:if="{{mode === 'full'}}"><scroll-view scroll-x="{{true}}" class="scroll-tabs"><button wx:for="{{regions}}" wx:key="*this" class="pill {{region === item ? 'active' : ''}}" data-value="{{item}}" bindtap="region">{{item}}</button></scroll-view><scroll-view wx:if="{{region !== 'Final Four'}}" scroll-x="{{true}}" class="scroll-tabs"><button wx:for="{{rounds}}" wx:key="id" class="pill {{round === item.id ? 'active' : ''}}" data-value="{{item.id}}" bindtap="round">{{item.name}}</button></scroll-view></view>
  <view wx:for="{{games}}" wx:key="id" wx:for-item="match" class="game"><view class="game-head">{{match.label}} · {{match.region}}</view><view wx:for="{{match.teams}}" wx:key="id" class="archive-team {{item.won ? 'winner' : ''}}"><image class="logo" src="{{item.logo}}" mode="aspectFit"/><view class="grow"><text class="seed">#{{item.seed}}</text><text class="team-name">{{item.name}}</text></view><text class="score">{{item.score}}</text><text wx:if="{{item.won}}" class="check">✓</text></view><button class="source-button" bindtap="source" data-id="{{match.id}}">Copy game box score link ↗</button></view><text class="notice">Actual archived results. These never change your playable bracket or demo results.</text>
</view><include src="../../templates/footer.wxml"/>
