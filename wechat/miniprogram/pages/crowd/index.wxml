<view class="page"><text class="kicker">The fan forecast</text><text class="title">Who’s the crowd backing?</text><text class="muted body">Predictions and favorites. Standings shows scores.</text><text class="notice">{{count}} saved {{count === 1 ? 'entry' : 'entries'}} on this device. A shared crowd feed is not connected in this development version.</text>
  <view wx:if="{{!count}}" class="card empty"><text class="section-title">Make the first call.</text><text class="muted body">Save a bracket to start the fan forecast.</text><button class="red" bindtap="bracket">Make my picks →</button></view>
  <view wx:if="{{count}}"><view class="card"><text class="section-title">Champion favorites.</text><button class="favorite" wx:for="{{favorites}}" wx:key="id" bindtap="profile" data-id="{{item.id}}"><view class="row"><image class="logo" src="{{item.logo}}" mode="aspectFit"/><text class="grow team-name">{{item.name}}</text><text class="score">{{item.percent}}%</text></view><progress percent="{{item.percent}}" activeColor="#D62B38" backgroundColor="#EAECF0" stroke-width="6" border-radius="6"/></button></view>
  <view class="card"><text class="section-title">Rooting choices.</text><view class="root-row" wx:for="{{roots}}" wx:key="id"><text style="color:{{item.color}}">● {{item.zh}} {{item.name}}</text><text>{{item.count}}</text></view><view class="root-row"><text>中 Follow a Chinese player</text><text>{{cn}}</text></view><view class="root-row"><text>Picked on their own</text><text>{{manual}}</text></view></view>
  <text class="section-title">Next matchups.</text><view class="card" wx:for="{{matchups}}" wx:key="id" wx:for-item="match"><text class="kicker">{{match.label}} · {{match.eligible}} eligible picks</text><view class="root-row" wx:for="{{match.teams}}" wx:key="id"><view class="row"><image class="logo" src="{{item.logo}}" mode="aspectFit"/><text class="bold">{{item.name}}</text></view><text class="score">{{item.percent}}%</text></view></view></view>
</view><include src="../../templates/footer.wxml"/>
