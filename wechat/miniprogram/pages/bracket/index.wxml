<view class="page"><view class="row between"><view><text class="kicker">NCAA 2026</text><text class="title">Your bracket.</text></view><text class="pick-counter">{{count}}<text> / 63</text></text></view><view class="row between"><button class="link" bindtap="learn">How it works ↗</button><button class="link" bindtap="clear" disabled="{{locked}}">Clear draft</button></view><text class="notice" wx:if="{{locked}}">Demo results have started. Picks are locked.</text>
  <button class="helper" bindtap="helpers">Help me choose <text>{{showHelpers ? '−' : '+'}}</text></button><view wx:if="{{showHelpers}}" class="card"><text class="kicker">Auto-fill 63 picks</text><text class="muted">Home regions are where schools are based. Tournament groups decide who plays whom.</text><view class="tabs"><button wx:for="{{roots}}" wx:key="id" class="pill" bindtap="fill" data-root="{{item.id}}" disabled="{{locked}}">{{item.zh}} {{item.name}}</button></view><text class="kicker">Follow a Chinese player</text><button wx:for="{{players}}" wx:key="id" class="school-row" bindtap="fill" data-root="cn" data-team="{{item.id}}" disabled="{{locked}}"><image class="logo" src="{{item.logo}}" mode="aspectFit"/><text class="grow">{{item.name}}</text><text>→</text></button><button class="link" bindtap="fill" disabled="{{locked}}">Surprise me · weighted by seed →</button></view>
  <text class="muted small body">Tap a team to pick. ⓘ opens its profile. 中 marks a Chinese player.</text>
  <scroll-view scroll-x="{{true}}" class="scroll-tabs"><button class="pill {{region === item.id ? 'active' : ''}}" wx:for="{{regions}}" wx:key="id" bindtap="region" data-id="{{item.id}}">{{item.name}} <text class="small">{{item.count}}/{{item.total}}</text></button></scroll-view>
  <scroll-view wx:if="{{region !== 'F'}}" scroll-x="{{true}}" class="scroll-tabs"><button wx:for="{{rounds}}" wx:key="id" class="pill {{round === item.id ? 'active' : ''}}" bindtap="round" data-id="{{item.id}}">{{item.label}}</button></scroll-view><button class="link" bindtap="seed">What is a seed? {{showSeed ? '−' : '+'}}</button><text class="notice" wx:if="{{showSeed}}">A seed is a team’s rank in its tournament group. Smaller number, higher rank.</text>
  <view wx:for="{{games}}" wx:key="id" wx:for-item="match" class="game"><view class="game-head">{{match.label}}</view><view wx:for="{{match.teams}}" wx:key="slot" class="team-row {{item.picked ? 'picked' : ''}}"><button class="team-pick" bindtap="pick" data-game="{{match.id}}" data-id="{{item.id}}" disabled="{{locked || !item.id}}" aria-pressed="{{item.picked}}"><image wx:if="{{item.logo}}" class="logo" src="{{item.logo}}" mode="aspectFit"/><view class="grow"><text class="seed" wx:if="{{item.seed}}">#{{item.seed}}</text><text class="team-name">{{item.name}}</text></view><text wx:if="{{item.cn}}" class="cn">中</text><text wx:if="{{item.picked}}" class="check">✓</text></button><button wx:if="{{item.id}}" class="info" bindtap="profile" data-id="{{item.id}}" aria-label="About {{item.name}}">ⓘ</button></view></view>
  <view class="card champion" wx:if="{{region === 'F' &amp;&amp; champion}}"><text class="kicker">Your champion</text><image class="champ-logo" src="{{champion.logo}}" mode="aspectFit"/><text class="section-title">{{champion.name}}</text></view><button wx:if="{{roundComplete &amp;&amp; region !== 'F'}}" class="red" bindtap="next">{{round === 4 ? 'Next tournament group' : 'Next round'}} →</button>
  <view class="card enter-card"><text class="section-title">{{dirty ? 'Your picks changed.' : submitted ? 'Your bracket is in.' : 'Make it yours.'}}</text><text class="muted">{{count}} of 63 picks · Draft saved on this device</text><text class="notice" wx:if="{{dirty}}">Update your entry to include your latest picks.</text><button class="link" bindtap="entry">{{showEntry ? 'Hide entry' : 'Save an entry'}} {{showEntry ? '−' : '+'}}</button><view wx:if="{{showEntry}}"><input class="field" value="{{name}}" placeholder="Fan name" maxlength="24" bindinput="name" disabled="{{locked}}" aria-label="Fan name"/><button class="red" disabled="{{count !== 63 || locked || !name}}" bindtap="submit">{{submitted ? 'Update my entry' : 'Save my bracket'}}</button><text class="muted small body">Development demo. No prize is awarded.</text></view><button class="link" wx:if="{{submitted}}" bindtap="nextFan" disabled="{{locked}}">Next fan on this device →</button><button class="link" wx:if="{{submitted}}" bindtap="standings">See standings →</button></view>
</view><include src="../../templates/footer.wxml"/>
