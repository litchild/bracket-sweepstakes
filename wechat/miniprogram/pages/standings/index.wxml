<view class="page"><text class="kicker">Every pick counts</text><text class="title">Standings.</text><text class="muted body">Scores, ranks and results. Crowd shows fan predictions.</text><view class="tabs"><button class="pill {{panel === 'board' ? 'active' : ''}}" data-value="board" bindtap="panel">Leaderboard</button><button class="pill {{panel === 'results' ? 'active' : ''}}" data-value="results" bindtap="panel">Tournament</button></view><text class="notice">{{count}} saved {{count === 1 ? 'entry' : 'entries'}} on this device. {{decided ? 'Points below use simulated demo results.' : 'No results yet.'}}</text>
  <view wx:if="{{panel === 'board'}}"><view wx:if="{{count &lt; 2}}" class="card empty"><image src="/assets/trophy.png" mode="aspectFit"/><text class="section-title">{{count ? 'Who’s next?' : 'The board starts with you.'}}</text><text class="muted body">Standings appear when two fans save entries on this device.</text><button class="red" bindtap="bracket">{{count ? 'Add another fan' : 'Make my picks'}} →</button></view><view wx:else><view class="leader-row" wx:for="{{rows}}" wx:key="id"><text class="rank">{{item.rank}}</text><view class="grow"><text class="team-name">{{item.name}}</text><view class="row"><image src="{{item.champion.logo}}" mode="aspectFit" class="leader-logo"/><text class="muted small">{{item.champion.name}} · {{item.correct}} correct</text></view></view><view class="points"><text class="score">{{item.points}}</text><text class="label">points</text></view></view></view></view>
  <view wx:if="{{panel === 'results'}}"><view class="card"><text class="kicker">Demo tournament</text><text class="section-title">{{decided}} / 63 games complete</text><text class="muted">{{decided ? 'Simulated results, separate from actual archives.' : 'Save your picks before starting a demo.'}}</text></view><view class="card" wx:for="{{games}}" wx:key="id"><text class="kicker">{{item.label}}</text><view class="row"><image src="{{item.winner.logo}}" class="logo" mode="aspectFit"/><text class="grow bold">{{item.winner.name}} advances</text><text class="check">✓</text></view></view></view>
  <button class="link" bindtap="demo">Demo controls {{showDemo ? '−' : '+'}}</button><view class="card" wx:if="{{showDemo}}"><text class="muted body">For trying scoring on this device.</text><button class="dark" disabled="{{finished}}" bindtap="simulate">{{finished ? 'Demo complete' : 'Simulate next round'}}</button><button class="link" disabled="{{!decided}}" bindtap="reset">Reset demo results</button></view>
</view><include src="../../templates/footer.wxml"/>
