page{background:#F0F1F4;color:#17191F;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;font-size:28rpx;line-height:1.5}
view,text,button,input{box-sizing:border-box}button{display:block;width:100%;border:0;margin:0;font-size:28rpx;line-height:1.35;border-radius:16rpx;background:#fff;color:#17191F;font-weight:700;padding:24rpx 28rpx}button::after{border:0}button[disabled]{opacity:.4}button::before{box-sizing:border-box}.pill,.link,.info,.team-pick{width:auto}
.page{padding:36rpx 28rpx 20rpx}.kicker{font-size:20rpx;line-height:1.3;font-weight:800;letter-spacing:2rpx;text-transform:uppercase;color:#6D7079;display:block;margin-bottom:12rpx}.title{font-size:64rpx;line-height:1.02;font-weight:900;letter-spacing:-3rpx;display:block;margin-bottom:30rpx}.section-title{font-size:40rpx;font-weight:850;line-height:1.12;letter-spacing:-1rpx;display:block;margin-bottom:18rpx}.body{display:block;margin:14rpx 0 24rpx}.muted{color:#6D7079;font-size:25rpx;display:block}.small{font-size:22rpx}.bold{font-weight:800}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.stack{display:flex;flex-direction:column;gap:20rpx}.grow{flex:1;min-width:0}.card{background:#fff;border:1rpx solid #E0E2E7;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.red{background:#D62B38;color:white}.dark{background:#141619;color:#fff}.outline{border:2rpx solid #D9DBE2;background:transparent}.link{background:transparent;color:#C92230;padding:18rpx 0;text-align:left;font-size:26rpx}.tabs{display:flex;gap:12rpx;flex-wrap:wrap;margin:22rpx 0}.pill{border-radius:100rpx;font-size:24rpx;padding:18rpx 24rpx;border:2rpx solid #DDDDE3;white-space:nowrap;background:#fff}.pill.active{background:#17191F;color:#fff;border-color:#17191F}.accent.active{background:#D62B38;border-color:#D62B38}.scroll-tabs{white-space:nowrap;width:100%;margin:18rpx 0 24rpx}.scroll-tabs .pill{display:inline-block;margin-right:12rpx}.divider{height:1rpx;background:#E1E3E8;margin:24rpx 0}.logo{width:64rpx;height:64rpx;flex:none}.team-name{font-weight:800;display:block}.seed{font-size:22rpx;color:#70747D}.cn{background:#CF2632;color:#fff;font-size:20rpx;border-radius:8rpx;padding:2rpx 8rpx}.school-row{width:100%;display:flex;align-items:center;gap:20rpx;text-align:left;padding:22rpx 0;border-bottom:1rpx solid #EAEBEE;border-radius:0}.school-row:last-child{border-bottom:0}.school-row .muted{font-weight:400;margin-top:4rpx;font-size:22rpx}.game{background:#fff;border:1rpx solid #DEE1E7;border-radius:22rpx;overflow:hidden;margin-bottom:20rpx}.game-head{padding:14rpx 22rpx;background:#F8F8FA;color:#666C78;font-size:20rpx;font-weight:700;text-transform:uppercase}.team-row{display:flex;align-items:stretch;min-height:120rpx}.team-pick{flex:1;text-align:left;background:transparent;display:flex;align-items:center;gap:18rpx;padding:20rpx 22rpx;border-radius:0;font-weight:500;min-width:0}.team-row.picked{background:#E3F8FC;box-shadow:inset 7rpx 0 #1AA5C0}.team-row+.team-row{border-top:1rpx solid #ECEEF2}.team-row .logo{width:56rpx;height:56rpx}.check{font-weight:800;color:#117D92;margin-left:auto}.info{background:transparent;color:#6D727B;padding:24rpx 22rpx;border-radius:0;font-size:30rpx;align-self:stretch}.empty{padding:50rpx 30rpx;text-align:center}.empty .section-title{margin-top:20rpx}.empty image{width:180rpx;height:140rpx}.footer{padding:34rpx 28rpx 50rpx;color:#777D87;text-align:center;font-size:20rpx;line-height:1.65}.footer text{display:block;margin-top:12rpx}.concept{display:inline-block!important;font-size:18rpx;letter-spacing:1rpx;text-transform:uppercase;border:1rpx solid #969BA5;border-radius:6rpx;padding:3rpx 8rpx;font-weight:700}.notice{padding:22rpx;background:#F4F5F8;border-radius:14rpx;color:#626875;font-size:24rpx;margin:18rpx 0}.score{font-size:34rpx;font-weight:900}.win{color:#087583}.field{width:100%;background:#F2F3F6;border:2rpx solid #E2E4E9;padding:24rpx;border-radius:14rpx;height:96rpx;font-size:28rpx;margin:16rpx 0}.spacer{height:20rpx}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.photo-credit{font-size:18rpx;opacity:.72;display:block;margin-top:16rpx}.path-step{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0}.rule{font-size:26rpx;margin:16rpx 0;display:block}.label{font-size:22rpx;color:#737885;display:block}
